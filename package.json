{
  "name": "llm-wallpapers",
  "version": "0.2.0",
  "module": "src/content/content.ts",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "build:release": "bun run build && bun scripts/package-release.ts",
    "test:unit": "bun test tests/*.test.ts",
    "test:dom": "bunx playwright test",
    "test:browser": "bunx playwright test wallpaper.spec.ts reading-comfort.spec.ts comfort-layout.spec.ts",
    "test:monitor": "bunx playwright test dom-check.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/chrome": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
